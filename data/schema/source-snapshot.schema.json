{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decision-geography:schema:source-snapshot",
  "title": "Decision Geography immutable source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_dataset_id",
    "url",
    "retrieved_at",
    "checksum",
    "media_type",
    "licence_status",
    "storage_path",
    "byte_size",
    "record_count"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^snp_[a-z0-9_]+$|^snp_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_dataset_id": {
      "type": "string",
      "pattern": "^dsd_[a-z0-9_]+$|^dsd_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "schema_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(sha256:[0-9a-f]{64})?$"
    },
    "licence_status": {
      "enum": [
        "verified",
        "unknown",
        "pending_review",
        "restricted"
      ]
    },
    "storage_path": {
      "type": "string",
      "minLength": 1
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
