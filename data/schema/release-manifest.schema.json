{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decision-geography:schema:release-manifest",
  "title": "Decision Geography named release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "created_at",
    "data_as_of",
    "schema_versions",
    "record_counts",
    "source_snapshot_ids",
    "checksums",
    "publication_blockers"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "record_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "source_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^snp_[a-z0-9_]+$|^snp_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "publication_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocker",
              "warning"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
