{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decision-geography:schema:place",
  "title": "Decision Geography place identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "created_at",
    "source_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^plc_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "enum": [
        "active",
        "historical",
        "retired"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "retired_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "record_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "record_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}