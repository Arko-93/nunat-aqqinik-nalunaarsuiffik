{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decision-geography:schema:administrative-area",
  "title": "Decision Geography administrative area",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "level",
    "source_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^adm_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "record_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "record_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}